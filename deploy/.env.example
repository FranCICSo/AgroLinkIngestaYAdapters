# Plantilla de variables de entorno del stack. Copiar a deploy/.env y completar con
# valores reales. deploy/.env NUNCA se commitea (Principio VI de la Constitucion).

# --- TimescaleDB ---
POSTGRES_DB=agrolink_telemetria
POSTGRES_SUPERUSER_PASSWORD=

# Rol de aplicacion del receptor UDP (SELECT, INSERT unicamente)
RINHO_RECEPTOR_DB_USER=rinho_receptor
RINHO_RECEPTOR_DB_PASSWORD=

# Rol de aplicacion del servicio de reportes (SELECT unicamente)
AGROLINK_INGESTA_DB_USER=agrolink_ingesta
AGROLINK_INGESTA_DB_PASSWORD=

# Rol de aplicacion del simulador de viajes (SELECT/INSERT/UPDATE solo sobre el schema
# `simulador`, sin ningun permiso sobre `telemetria` - feature 009-simulador-viajes)
SIMULADOR_VIAJES_DB_USER=simulador_viajes
SIMULADOR_VIAJES_DB_PASSWORD=

# --- rinho-receptor (Node.js) ---
UDP_PORT=5000
UDP_HOST=0.0.0.0
RECEPTOR_HEALTH_PORT=8081
DB_HOST=timescaledb
DB_PORT=5432
DEDUP_CACHE_TTL_MS=300000

# Parche de despliegue (D-12): dejar en 0 salvo que el equipo este configurado con hora
# LOCAL en vez de UTC en el campo de hora de la trama EQ (el contrato del fabricante dice
# que debe ser UTC). Si hace falta, poner las horas a SUMAR para llegar de local a UTC real
# (Argentina sin horario de verano: 3). Ver deploy/README.md.
DEVICE_HORA_UTC_OFFSET_HOURS=0

# --- simulador-viajes (Node.js) ---
# Por defecto apunta al rinho-receptor local del propio stack. Para enviar tramas contra
# la VM de OCI hay que fijar APUNTAR_A_PRODUCCION=true Y RECEPTOR_HOST a esa VM de forma
# explicita (nunca por defecto - FR-012, feature 009-simulador-viajes).
RECEPTOR_HOST=rinho-receptor
RECEPTOR_PORT=5000
APUNTAR_A_PRODUCCION=false

# Feature 011-generar-ruta-simulada. OSRM_BASE_URL apunta al demo server publico de OSRM
# (no hay contenedor OSRM: su imagen no corre en la VM de produccion, que es ARM); solo hace
# falta pisarlo si se quiere apuntar a otro OSRM. Si se define, SIMULADOR_PUERTO_HTTP NUNCA
# debe publicarse en `ports:` (research.md D-04): solo se consume desde la red interna del
# compose.
#
# OBLIGATORIA (=8090) si se usa la feature 013-autostart-simulacion-viaje:
# agrolink-ingesta llama por default a http://simulador-viajes:8090 (ver
# agrolink.simulador-viajes.base-url en application.yaml) para arrancar la simulacion de un
# viaje. Sin esta variable seteada a 8090, el servidor HTTP de simulador-viajes (POST /rutas)
# no levanta y cada intento de arranque queda en ERROR (logueado, sin romper el alta del
# viaje) aunque el contenedor este corriendo. Sin la feature 013, sigue siendo opcional (solo
# la necesita el CLI alternativo `npm run crear-ruta` vs el endpoint HTTP).
OSRM_BASE_URL=https://router.project-osrm.org
SIMULADOR_PUERTO_HTTP=8090

# Feature 015-samsara-webhook-exceso-velocidad: emisor de webhooks Samsara simulado (dentro de
# simulador-viajes). Necesita SIMULADOR_PUERTO_HTTP para recibir los avisos de viaje. Umbral
# de exceso severo = LIMITE + MARGEN (km/h). EXCESOS_POR_HORA es la tasa media de rafagas por
# vehiculo con viaje en curso: 0.3125 = 2,5 cada 8 h; para una demo corta, 6 (~1 cada 10 min).
SAMSARA_EMISOR_HABILITADO=false
# Sin definir: en Docker, compose usa http://agrolink-ingesta:${REPORTES_HTTP_PORT}/api/v1/proveedores/samsara/webhook;
# con 'make simulador' (local) el Makefile la fija en http://localhost:${REPORTES_HTTP_PORT}/...
#SAMSARA_WEBHOOK_URL=
SAMSARA_LIMITE_KMH=80
SAMSARA_MARGEN_KMH=20
SAMSARA_CICLO_MS=5000
SAMSARA_EXCESOS_POR_HORA=0.3125
# Solo completan el sobre del webhook (orgId / webhookId); defaults 1001 / agrolink-poc.
#SAMSARA_ORG_ID=1001
#SAMSARA_WEBHOOK_ID=agrolink-poc

# Feature 016-alerta-temperatura-motor: temperatura del refrigerante del motor en las tramas
# simuladas (normal 80-95 C) y sobrecalentamiento. Cada viaje nuevo (incluida la vuelta
# automatica) sortea una falla con PROBABILIDAD_PCT (0 = nunca al azar); si sale, arranca en un
# punto al azar del recorrido y dura entre DURACION_MIN_MIN y DURACION_MAX_MIN minutos. A mano:
#   docker compose exec simulador-viajes curl -s -X POST   localhost:8090/camiones/900002/falla-motor
#   docker compose exec simulador-viajes curl -s -X DELETE localhost:8090/camiones/900002/falla-motor
# SUBIDA_C_POR_TRAMA es por trama (ciclo de SIMULADOR_CICLO_MS); PICO_C debe superar 105 C (umbral
# de alerta por defecto del backend) para que la demo dispare la alerta.
MOTOR_FALLA_PROBABILIDAD_PCT=5
MOTOR_FALLA_DURACION_MIN_MIN=20
MOTOR_FALLA_DURACION_MAX_MIN=40
MOTOR_SUBIDA_C_POR_TRAMA=2
MOTOR_PICO_C=115

# Feature 016 (ampliacion): nivel del tanque de combustible en las tramas simuladas (CAN 15).
# Baja PCT_POR_KM por km recorrido (0,05 = tanque de ~700 l a 0,35 l/km); cuando una trama
# informa menos de RECARGA_DEBAJO_PCT, la siguiente ya viene con el tanque al 100 %. Cada camion
# arranca con un nivel al azar entre ese umbral y 100 %. Para ver recargas rapido en una demo,
# subir PCT_POR_KM (por ejemplo 0.5).
COMBUSTIBLE_PCT_POR_KM=0.05
COMBUSTIBLE_RECARGA_DEBAJO_PCT=7

# --- agrolink-ingesta (Spring Boot) ---
# Puerto interno (nunca publicado). Fuera de 8080 para no chocar con AgroLinkBackend
# cuando ambos corren localmente como procesos Spring Boot (ambos por defecto en 8080).
REPORTES_HTTP_PORT=8083

# Puerto propio de la consulta de estado de vehiculo (GET /api/v1/vehiculos/{id}/estado),
# distinto de REPORTES_HTTP_PORT. Es el UNICO puerto de agrolink-ingesta que se publica al
# host: REPORTES_HTTP_PORT sigue siendo interno (research.md D-01, feature 002).
VEHICULO_ESTADO_HTTP_PORT=8082
